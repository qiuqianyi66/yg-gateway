.env
.env.*

# Binaries (anchored to repo root only — bare "login"/"credit" would also ignore cmd/login/, cmd/credit/)
/login
/credit
/yg-gateway
/signin_bin
# Windows 构建产物（go build 默认带 .exe 后缀；上面四条是 Linux/Mac 形态）
/login.exe
/credit.exe
/yg-gateway.exe
/server.exe
/harnessrun.exe

# Config with secrets (use config.example.json)
config.json

# Build artifacts
*.tmp
__pycache__/

# Binary backups（部署前留的旧版二进制，含凭证无关但体积大，不入库）
bin/

# 真机验证产物（Playwright 截图等，属本地验证证据，复现命令见 review.md）
verify/

# Backups (contains auth tokens)
backups/

# IDE
.idea/
.vscode/

# 个人草稿（根目录 scratch，非工程产物）
/LOOP.md
/PLAN.md
/SPEC.md

# 私有提示词资产（个人人格位，非项目必需；开源版用 config.example.json 的默认 passthrough）
/persona.md

# ── 文档与治理：默认跟踪 ─────────────────────────────────────────────────
# 早期沿用上游的 `*.md` + `docs/` 全忽略策略，副作用是 .harness 规范、docs/prd
# 需求文档、.harness/changes 变更记录全部无法入库——十阶段流水线的「可追溯」因此
# 形同虚设（summary.md 里引用的需求编号在版本库里根本不存在）。
# 现改为默认跟踪 md，只在上面单独排除个人草稿；密钥仍在文件头单独忽略。
# 如需恢复旧策略，在上面的 IDE 段加回 `docs/` 与 `*.md` 即可。
# （此规则调整已记入 .harness/changes/panel-spec/summary.md）

# Windows binaries
/yg-gateway.exe
/login.exe
/credit.exe

# 运行时日志与部署备份（本机运行产物，不入库）
/.stderr.log
/.stdout.log
/yg-gateway.exe.*.bak

# 本地验证工具（判据逆向过程脚本，结论沉淀于 data/desktop-task-protocol.md）
/cmd/desktopverify*/
*.zip
server.exe
.DS_Store

# ── 本机代理产物 / 个人草稿：绝不入库（仓库为 PUBLIC，见 2026-10-24 安全复核）────
# .workbuddy：本地 AI 代理记忆（个人上下文，含本机路径与工作细节，非项目产物）
/.workbuddy/
# git worktree 元数据锚点（由 git worktree 生成，不应随仓库分发）
/yg-gateway-worktrees/
# 临时草稿目录（doc/image 工具的中间产物，命名带随机 id）
/draft_*_folder/
# docs/research 的渲染截图导出物（约 4.4MB 的 jpg + 含本机绝对路径的 report.json；
# 源文档 docs/research/*.html 仍入库，截图可随时重新生成）
/docs/research/_shots/
# ── 个人私有资产：绝不入库（2026-10-24 复核发现，此前已误入公网）──────────────
# image_edited.png：聊天截图，**画面里含明文 API Key**，且是私人对话
/image_edited.png
# 项目交接 / 工作准则 / 审查收口：个人工作上下文，含私有实例路径与内部账号数
/HANDOFF.md
/工作准则-融入版.md
/yg-gateway_四维度审查收口_*.md
/yg-gateway_四维度审查收口_*.json
# 产品研究与 PRD 草稿（私有策略材料，不随代码开源）
/docs/research/
# 面板截图：画面含真实账号昵称与账号 UUID 片段（个人信息），不入库
/docs/screenshots/panel-*.png
/.harness/changes/2026-10-18-b1b-panel-unknown-visual/panel-unknowns-*.png
# 工具层 hook 状态（mimosa）；内容无害但不该进库
/.mimosa/
